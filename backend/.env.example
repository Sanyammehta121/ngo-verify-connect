# =============================================================================
# TrueNGO Environment Configuration Template (.env.example)
# Copy this file to .env and configure your credentials.
# NEVER commit your real secrets to version control.
# =============================================================================

# Server Port & Core Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JSON Web Token Configuration (Minimum 32 random characters for HMAC SHA-256)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 1. Google OAuth 2.0 / OpenID Connect Credentials
# Setup via: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins:
#   - http://localhost:5173
#   - http://localhost:5000
# Authorized Redirect URIs:
#   - http://localhost:5173
#   - http://localhost:5000
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# 2. GitHub OAuth Application Credentials
# Setup via: https://github.com/settings/developers -> New OAuth App
# Homepage URL: http://localhost:5173
# Authorization Callback URL:
#   - http://localhost:5000/api/auth/github/callback
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# -----------------------------------------------------------------------------
# 3. SMTP Mail Configuration (Optional - for real email verification dispatch)
# In development, verification codes are logged to the console and returned in response
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TrueNGO Verification <noreply@truengo.org>"
